# Exemplo de notificação via Resend HTTPS (produção no Deplexo — SMTP bloqueado).
# Crie conta em https://resend.com, verifique um remetente e gere a API key.
RESEND_API_KEY=re_troque-por-sua-chave
CIEE_EMAIL_FROM=monitor@seu-dominio-verificado.com
CIEE_EMAIL_TO=destino@example.com

# Fallback SMTP local (quando RESEND_API_KEY ausente, usa SMTP).
# CIEE_EMAIL_HOST=smtp.example.com
# CIEE_EMAIL_PORT=587
# CIEE_EMAIL_USER=usuario@example.com
# CIEE_EMAIL_PASSWORD=troque-por-sua-senha
# CIEE_EMAIL_TO=destino@example.com

# Filtro de vagas por palavras-chave (opcional, separado por vírgula).
# Sem definir, usa a lista padrão de termos de software em ciee_monitor/keywords.py.
# CIEE_KEYWORDS=desenvolvimento,software,programação,java,python,backend,frontend
