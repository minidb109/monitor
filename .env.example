# Exemplo de configuração de e-mail (valores fictícios — nunca commite credenciais reais).
# Copie para um arquivo .env local (ignorado pelo git) ou exporte as variáveis no shell.
CIEE_EMAIL_HOST=smtp.example.com
CIEE_EMAIL_PORT=587
CIEE_EMAIL_USER=usuario@example.com
CIEE_EMAIL_PASSWORD=troque-por-sua-senha
CIEE_EMAIL_TO=destino@example.com
